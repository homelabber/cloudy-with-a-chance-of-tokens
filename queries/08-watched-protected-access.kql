let WatchedApps = dynamic(__WatchedAppIds__);
let ProtectedResources = dynamic(__ProtectedResourceIds__);
let ReviewedOperations = dynamic(__MonitoredActionTypes__);
let ApprovedApps = dynamic(__ApprovedAppIds__);
CloudAppEvents
| where Timestamp > ago(__LOOKBACK__)
| where isnotempty(OAuthAppId) and OAuthAppId in~ (WatchedApps) and OAuthAppId !in~ (ApprovedApps)
| where ObjectId in (ProtectedResources) and ActionType in~ (ReviewedOperations)
| where AccountType in~ ("Regular", "Admin")
| where isnotempty(AccountObjectId) and isnotempty(ReportId)
| project Timestamp, ReportId, AccountObjectId, OAuthAppId, Application, ActionType, ObjectId, ObjectType, IPAddress, AuditSource
